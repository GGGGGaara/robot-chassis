<?xml version="1.0"?>
<package format="3">
  <name>tracer_bringup</name><version>0.3.0</version>
  <description>Unified ROS2 mapping, localization, model recording and TRACER navigation bringup.</description>
  <maintainer email="local@example.invalid">TRACER team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>std_msgs</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend><exec_depend>tf2_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>nav2_bringup</exec_depend><exec_depend>tracer_navigation_driver</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
