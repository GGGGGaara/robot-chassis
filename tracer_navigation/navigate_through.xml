<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="15" name="WaitForTemporaryObstacle">
     <PipelineSequence name="ReplanThroughAndFollow">
      <RateController hz="1.0">
        <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="general_goal_checker"/>
     </PipelineSequence>
     <Wait wait_duration="2.0"/>
    </RecoveryNode>
  </BehaviorTree>
</root>
