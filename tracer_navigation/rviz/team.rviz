Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
    - Class: rviz_default_plugins/Map
      Name: Navigation Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Live 3D Model
      Enabled: true
      Topic:
        Value: /mapping/global_points
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Size (m): 0.035
      Style: Points
      Color Transformer: AxisColor
      Position Transformer: XYZ
      Axis: Z
    - Class: rviz_default_plugins/Map
      Name: Live Clearance Evidence
      Enabled: false
      Alpha: 0.6
      Topic:
        Value: /navigation/live_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Reference Only
      Enabled: false
      Alpha: 0.25
      Topic:
        Value: /navigation/reference_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Current Obstacle Cloud
      Enabled: true
      Topic:
        Value: /points_navigation
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.04
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 100; 60
      Position Transformer: XYZ
    - Class: rviz_default_plugins/Path
      Name: Planned Route
      Enabled: true
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 50; 255; 100
    - Class: rviz_default_plugins/Odometry
      Name: LIO Pose
      Enabled: true
      Topic:
        Value: /lio/odom
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Reliable
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/PublishPoint
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 11
      Pitch: 0.8
      Yaw: 0.7
      Focal Point: {X: 0, Y: 0, Z: 0}
Window Geometry:
  Width: 1200
  Height: 850
