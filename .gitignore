# Root allowlist: this workspace also contains private assets and nested repositories.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/PROJECT_STATUS.md
!/CONTRIBUTING.md
!/THIRD_PARTY.md
!/.github/
!/.github/**
!/config/
!/config/**
/config/local.env
!/tools/
!/tools/**
!/third_party/
!/third_party/**
!/docs/
/docs/*
!/docs/team/
!/docs/team/**
!/tracer_navigation/
/tracer_navigation/*
!/tracer_navigation/*.py
!/tracer_navigation/*.sh
!/tracer_navigation/*.ps1
!/tracer_navigation/*.xml
!/tracer_navigation/robot.yaml
!/tracer_navigation/apt_sources.list
!/tracer_navigation/README.md
!/tracer_navigation/ROS2统一架构与队友接口.md
!/tracer_navigation/坐标导航与实时建模_使用指南.md
!/tracer_navigation/rviz/
!/tracer_navigation/rviz/**
!/tracer_navigation/ws/
/tracer_navigation/ws/*
!/tracer_navigation/ws/src/
!/tracer_navigation/ws/src/**
!/realtime_mapping_usage/
/realtime_mapping_usage/*
!/realtime_mapping_usage/*.py
!/realtime_mapping_usage/*.sh
!/realtime_mapping_usage/*.html
!/realtime_mapping_usage/*.md
# Never override these for local generated files or secrets.
**/__pycache__/
**/*.pyc
**/.venv/
**/.ros_venv/
**/.ios_venv/
**/build/
**/install/
**/log/
**/node_modules/
**/.env
**/.env.*
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
**/.DS_Store
**/Thumbs.db
# The current OAuth token cannot publish active workflows. Keep the local copy;
# docs/team/ci/offline.yml is the versioned, inactive template.
/.github/workflows/offline.yml
